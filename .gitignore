# Unity standard ignores (based on https://github.com/github/gitignore/blob/main/Unity.gitignore)
# WHY (laptop-sync): the previous .gitignore globally ignored *.meta, *.prefab, *.unity, *.asset,
# *.mat, *.fbx, *.png, *.anim, Assets/Realistic Drone, Polyart, ithappy — which made Unity
# unusable on any clone. Restored to standard.

# Unity-generated folders
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# Repo-local moved-out asset cache
/_unused_assets/

# Logs
*.log

# Unity Asset Store installers (the runtime content gets imported into Assets/)
*.unitypackage
*.unitypackage.meta

# Blender autosaves
*.blend1
*.blend1.meta

# Crash + diagnostic dumps
sysinfo.txt
mono_crash.*

# IDE / VS / Rider auto-generated solution files (Unity regenerates)
.vs/
.consulo/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D meta of auto-generated files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# JetBrains Rider local settings
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# Apple builds
*.app

# Android builds
*.apk
*.aab

# Crashlytics
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables defaults
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Project-specific deploy markers
/tmp/dronedetect_webgl_build_status.txt

# Editor session cache (Claude Code agent CLI state — not project)
.claude/

# Training run output — huge .pt checkpoints, regeneratable from training.
# Excluded since 2026-05-17 to stop gitingest from timing out on clone.
results/

